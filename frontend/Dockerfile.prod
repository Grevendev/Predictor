FROM node:24-slim AS builder
WORKDIR /app

# Ta emot bas-sökvägen som byggargument med fallback till /predictor/
ARG VITE_BASE_PATH=/predictor/
ENV VITE_BASE_PATH=$VITE_BASE_PATH

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Produktionssteg
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]