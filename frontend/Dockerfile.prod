# -------------------------------------------------------------
# Steg 1: Bygg React-appen med Vite
# -------------------------------------------------------------
FROM node:24-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Sätt bas-sökvägen så Vite bygger script och css under /predictor/
ENV VITE_BASE_PATH=/predictor/
RUN npm run build

# -------------------------------------------------------------
# Steg 2: Skapa den lilla Nginx-imagen som ska köras i prod
# -------------------------------------------------------------
FROM nginx:alpine

# Rensa Nginx standard-välkomstsida
RUN rm -rf /usr/share/nginx/html/*

# 1. Kopiera de färdigbyggda filerna till undermappen 'predictor'
COPY --from=builder /app/dist /usr/share/nginx/html/predictor

# 2. Kopiera in din anpassade nginx.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]